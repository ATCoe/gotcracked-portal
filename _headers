/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.discordapp.com https://uvpmmbioerejeyybfntb.supabase.co https://upload.wikimedia.org; connect-src 'self' https://uvpmmbioerejeyybfntb.supabase.co wss://uvpmmbioerejeyybfntb.supabase.co https://discord.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/
  Cache-Control: no-store, max-age=0

/index.html
  Cache-Control: no-store, max-age=0

/theme-bootstrap.js
  Cache-Control: no-store, max-age=0

/portal-runtime-loader.js
  Cache-Control: no-store, max-age=0

/*.js
  Cache-Control: no-store, max-age=0

/*.css
  Cache-Control: no-store, max-age=0

/assets/*
  Cache-Control: public, max-age=31536000, immutable
